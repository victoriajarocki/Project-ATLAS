# Available providers: mock, openai, ollama
ATLAS_PROVIDER=mock

# The model name must match the selected provider.
ATLAS_MODEL=mock-model

# Local Ollama API address.
OLLAMA_HOST=http://localhost:11434

# Local SQLite memory database.
ATLAS_MEMORY_DATABASE=data/atlas_memory.db

# Required only when ATLAS_PROVIDER=openai.
OPENAI_API_KEY=