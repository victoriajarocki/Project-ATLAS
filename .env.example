# Available providers: mock, openai, ollama
ATLAS_PROVIDER=mock

# The model name must match the selected provider.
ATLAS_MODEL=mock-model

# Local Ollama API address.
OLLAMA_HOST=http://localhost:11434

# Local SQLite database for memories and conversations.
ATLAS_MEMORY_DATABASE=data/atlas_memory.db

# Logging configuration.
ATLAS_LOG_DIRECTORY=logs
ATLAS_LOG_LEVEL=INFO
ATLAS_LOG_MAX_BYTES=5000000
ATLAS_LOG_BACKUP_COUNT=5

# Semicolon-separated directories that ATLAS may access.
# Relative paths are resolved from the project directory.
ATLAS_ALLOWED_DIRECTORIES=workspace

# Maximum UTF-8 file size ATLAS may read.
ATLAS_FILESYSTEM_MAX_READ_BYTES=1000000

# Maximum number of characters ATLAS may write.
ATLAS_FILESYSTEM_MAX_WRITE_CHARACTERS=1000000

# Required only when ATLAS_PROVIDER=openai.
OPENAI_API_KEY=